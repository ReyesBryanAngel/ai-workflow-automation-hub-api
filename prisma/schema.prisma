// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailCategory {
  SALES
  SUPPORT
  BILLING
  COMPLAINT
  GENERAL_INQUIRY
  SPAM
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmailStatus {
  PENDING
  PROCESSED
  FAILED
}

enum WorkflowStatus {
  SUCCESS
  FAILED
  RETRYING
}

enum InvoiceStatus {
  PENDING
  DUPLICATE
  NEEDS_REVIEW
  APPROVED
  REJECTED
  EXPORTED
  PAID
  ARCHIVED
}

enum InvoiceSourceType {
  EMAIL
  DRIVE
  UPLOAD
  API
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
}

model Email {
  id        Int            @id @default(autoincrement())
  sender    String
  subject   String
  body      String
  category  EmailCategory?
  priority  Priority?
  summary   String?
  status    EmailStatus    @default(PENDING)
  createdAt DateTime       @default(now())
  repliedAt DateTime?

  crmRecords   CrmRecord[]
  workflowLogs WorkflowLog[]

  @@map("emails")
}

model WorkflowLog {
  id            Int            @id @default(autoincrement())
  workflow      String
  status        WorkflowStatus
  executionTime Int?
  error         String?
  retryCount    Int            @default(0)
  createdAt     DateTime       @default(now())

  email   Email? @relation(fields: [emailId], references: [id])
  emailId Int?

  @@map("workflow_logs")
}

model CrmRecord {
  id           Int      @id @default(autoincrement())
  customerName String?
  email        String
  company      String?
  source       String
  createdAt    DateTime @default(now())

  sourceEmail   Email? @relation(fields: [sourceEmailId], references: [id])
  sourceEmailId Int?

  @@map("crm_records")
}

// Internal reference content used to ground POST /api/ai/reply drafts (basic
// RAG: retrieved via Postgres full-text search in knowledgeBase.service.ts,
// filtered/boosted by category, then injected into the reply prompt as
// trusted context — distinct from the untrusted <email_body> content).
model KnowledgeArticle {
  id        Int            @id @default(autoincrement())
  title     String
  content   String
  category  EmailCategory?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("knowledge_articles")
}

// Extracted invoice fields + document reference (Phase 9.1). Extraction
// fields (invoiceNumber, vendor, dates, amounts) are nullable because a row
// is created from the stored file at upload time, before the OCR/extraction
// step (Phase 9.3) has run and filled them in.
model Invoice {
  id            Int       @id @default(autoincrement())
  invoiceNumber String?
  vendor        String?
  invoiceDate   DateTime?
  dueDate       DateTime?
  subtotal      Decimal?  @db.Decimal(12, 2)
  tax           Decimal?  @db.Decimal(12, 2)
  total         Decimal?  @db.Decimal(12, 2)
  currency      String    @default("USD")

  status InvoiceStatus @default(PENDING)

  storageKey  String
  documentUrl String?
  sourceType  InvoiceSourceType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

// Known vendors an extracted invoice can be fuzzy-matched against (Phase
// 9.4). Deliberately not linked to Invoice yet — the matching relation is
// introduced alongside the matching logic itself, not speculatively here.
model Vendor {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  email     String?
  createdAt DateTime @default(now())

  @@map("vendors")
}

// Purchase orders an extracted invoice can be reconciled against (Phase
// 9.4), same reasoning as Vendor above re: no Invoice relation yet.
model PurchaseOrder {
  id        Int      @id @default(autoincrement())
  poNumber  String   @unique
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@map("purchase_orders")
}

// DB-backed override for the Claude system prompts in src/prompts, keyed by
// PromptTemplateKey. Lets Module 5 Settings edit prompt wording without a
// redeploy; absence of a row (or isActive=false) falls back to the
// hardcoded default in the corresponding prompt file.
model PromptTemplate {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  description String?
  content     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prompt_templates")
}
