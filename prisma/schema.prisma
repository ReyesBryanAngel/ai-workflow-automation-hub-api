// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailCategory {
  SALES
  SUPPORT
  BILLING
  COMPLAINT
  GENERAL_INQUIRY
  SPAM
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmailStatus {
  PENDING
  PROCESSED
  FAILED
}

enum WorkflowStatus {
  SUCCESS
  FAILED
  RETRYING
}

enum InvoiceStatus {
  PENDING
  DUPLICATE
  NEEDS_REVIEW
  APPROVED
  REJECTED
  EXPORTED
  PAID
  ARCHIVED
}

enum InvoiceSourceType {
  EMAIL
  DRIVE
  UPLOAD
  API
}

// Phase 9.5: minimal authorization level on top of the existing JWT-only
// auth. Only APPROVER/ADMIN may approve or reject an invoice; MEMBER is the
// default for anyone else (e.g. the seeded admin is promoted explicitly).
enum UserRole {
  ADMIN
  APPROVER
  MEMBER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(MEMBER)
  createdAt    DateTime @default(now())

  reviewedInvoices Invoice[] @relation("InvoiceReviewedBy")

  @@map("users")
}

model Email {
  id        Int            @id @default(autoincrement())
  sender    String
  subject   String
  body      String
  category  EmailCategory?
  priority  Priority?
  summary   String?
  status    EmailStatus    @default(PENDING)
  createdAt DateTime       @default(now())
  repliedAt DateTime?

  crmRecords   CrmRecord[]
  workflowLogs WorkflowLog[]

  @@map("emails")
}

model WorkflowLog {
  id            Int            @id @default(autoincrement())
  workflow      String
  status        WorkflowStatus
  executionTime Int?
  error         String?
  retryCount    Int            @default(0)
  createdAt     DateTime       @default(now())

  email   Email? @relation(fields: [emailId], references: [id])
  emailId Int?

  @@map("workflow_logs")
}

model CrmRecord {
  id           Int      @id @default(autoincrement())
  customerName String?
  email        String
  company      String?
  source       String
  createdAt    DateTime @default(now())

  sourceEmail   Email? @relation(fields: [sourceEmailId], references: [id])
  sourceEmailId Int?

  @@map("crm_records")
}

// Internal reference content used to ground POST /api/ai/reply drafts (basic
// RAG: retrieved via Postgres full-text search in knowledgeBase.service.ts,
// filtered/boosted by category, then injected into the reply prompt as
// trusted context — distinct from the untrusted <email_body> content).
model KnowledgeArticle {
  id        Int            @id @default(autoincrement())
  title     String
  content   String
  category  EmailCategory?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("knowledge_articles")
}

// Extracted invoice fields + document reference (Phase 9.1). Extraction
// fields (invoiceNumber, vendor, dates, amounts) are nullable because a row
// is created from the stored file at upload time, before the OCR/extraction
// step (Phase 9.3) has run and filled them in.
model Invoice {
  id            Int       @id @default(autoincrement())
  invoiceNumber String?
  vendor        String?
  poNumber      String?
  invoiceDate   DateTime?
  dueDate       DateTime?
  subtotal      Decimal?  @db.Decimal(12, 2)
  tax           Decimal?  @db.Decimal(12, 2)
  total         Decimal?  @db.Decimal(12, 2)
  currency      String    @default("USD")

  status InvoiceStatus @default(PENDING)

  // Populated by the Phase 9.4 checks pipeline. vendorId is only set on a
  // confident fuzzy match against Vendor — never auto-created from
  // unverified extraction. purchaseOrderId is only set on an exact
  // poNumber match against PurchaseOrder. exceptions collects human-readable
  // reasons from the risk rules (missing PO, amount mismatch, unverified
  // vendor, over-threshold total); a non-empty array means status is
  // NEEDS_REVIEW.
  matchedVendor   Vendor?        @relation(fields: [vendorId], references: [id])
  vendorId        Int?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId Int?
  exceptions      String[]       @default([])

  storageKey  String
  documentUrl String?
  sourceType  InvoiceSourceType

  // Phase 9.5 human approval. rejectionReason is required by the reject
  // endpoint (never set on approval); reviewedBy/reviewedAt record which
  // APPROVER/ADMIN user acted and when, cleared back to null if the same
  // invoice is later re-reviewed (it can't be, today's checks pipeline never
  // re-runs on a PENDING/NEEDS_REVIEW-only transition, but the fields stay
  // nullable rather than write-once).
  rejectionReason String?
  reviewedBy      User?     @relation("InvoiceReviewedBy", fields: [reviewedById], references: [id])
  reviewedById    Int?
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

// Known vendors an extracted invoice can be fuzzy-matched against (Phase
// 9.4).
model Vendor {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  email     String?
  createdAt DateTime @default(now())

  invoices Invoice[]

  @@map("vendors")
}

// Purchase orders an extracted invoice can be reconciled against (Phase 9.4).
model PurchaseOrder {
  id        Int      @id @default(autoincrement())
  poNumber  String   @unique
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  invoices Invoice[]

  @@map("purchase_orders")
}

// DB-backed override for the Claude system prompts in src/prompts, keyed by
// PromptTemplateKey. Lets Module 5 Settings edit prompt wording without a
// redeploy; absence of a row (or isActive=false) falls back to the
// hardcoded default in the corresponding prompt file.
model PromptTemplate {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  description String?
  content     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prompt_templates")
}
